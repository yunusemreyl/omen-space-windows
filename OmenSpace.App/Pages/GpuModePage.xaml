<Page
    x:Class="OmenSpace_App.Pages.GpuModePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource OmenAppBackgroundBrush}">

    <Page.Resources>
        <!-- LLT Style Card Container -->
        <Style TargetType="Border" x:Key="LltCardStyle">
            <Setter Property="Background" Value="{ThemeResource OmenCardBackgroundDarkBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource OmenCardBorderDarkBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>

        <!-- LLT Style Row Container -->
        <Style TargetType="Grid" x:Key="LltRowStyle">
            <Setter Property="Padding" Value="16" />
            <Setter Property="MinHeight" Value="64" />
        </Style>
    </Page.Resources>

    <Grid>
        <!-- HIDDEN ELEMENTS FOR BACKWARD COMPATIBILITY -->
        <StackPanel Visibility="Collapsed">
            <RadioButton x:Name="BtnMuxHybrid" />
            <RadioButton x:Name="BtnMuxDiscrete" />
        </StackPanel>

        <Grid Padding="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Navigation / Page Title -->
            <Grid Grid.Row="0" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Graphics" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource OmenPrimaryTextBrush}"/>
                    <TextBlock Text="Select GPU operation mode. Changes may require a system restart." FontSize="12" Foreground="{ThemeResource OmenTertiaryTextBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Loading Indicator -->
            <ProgressRing x:Name="LoadingRing" Grid.Row="1" IsActive="True" Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource OmenAccentBrush}"/>

            <!-- Main Switcher Container -->
            <Grid x:Name="GpuButtonsGrid" Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Stretch" Visibility="Collapsed">
                
                <StackPanel>
                    <!-- Graphics Modes Card -->
                    <Border Style="{StaticResource LltCardStyle}">
                        <StackPanel>
                            
                            <!-- Hybrid Mode Row -->
                            <Grid Style="{StaticResource LltRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE97B;" FontSize="20" Margin="0,0,16,0" Foreground="{ThemeResource OmenSecondaryTextBrush}"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="GPU Working Mode" FontWeight="SemiBold" FontSize="14" Foreground="{ThemeResource OmenPrimaryTextBrush}"/>
                                    <TextBlock Text="Select GPU operating mode based on your usage. Switching requires restart." FontSize="11" Foreground="{ThemeResource OmenSecondaryTextBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ComboBox x:Name="CmbGpuMode" Grid.Column="2" Width="150" VerticalAlignment="Center" SelectedIndex="0" SelectionChanged="CmbGpuMode_SelectionChanged">
                                    <ComboBoxItem Content="Hybrid" />
                                    <ComboBoxItem Content="Discrete" />
                                </ComboBox>
                            </Grid>
                            
                            <Border Height="1" Background="{ThemeResource OmenCardBorderDarkBrush}" Margin="16,0" />

                            <!-- Discrete GPU Info Row -->
                            <Grid Style="{StaticResource LltRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE7A6;" FontSize="20" Margin="0,0,16,0" Foreground="{ThemeResource OmenSecondaryTextBrush}"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Discrete GPU Status" FontWeight="SemiBold" FontSize="14" Foreground="{ThemeResource OmenPrimaryTextBrush}"/>
                                    <TextBlock Text="Indicates whether the discrete GPU is currently handling displays." FontSize="11" Foreground="{ThemeResource OmenSecondaryTextBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse x:Name="DiscreteGpuStatusDot" Width="8" Height="8" Fill="#10B981" Margin="0,0,6,0" />
                                    <TextBlock x:Name="DiscreteGpuStatusText" Text="Active" FontSize="12" Foreground="{ThemeResource OmenPrimaryTextBrush}"/>
                                </StackPanel>
                            </Grid>

                        </StackPanel>
                    </Border>
                    
                    <!-- System Info Placeholder -->
                    <Border Style="{StaticResource LltCardStyle}" Margin="0,8,0,0">
                        <StackPanel Padding="16" Spacing="12">
                            <!-- Internal Panel -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Internal Panel" FontSize="13" Foreground="{ThemeResource OmenPrimaryTextBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="eDP-1 → Connected" FontSize="12" Foreground="{ThemeResource OmenSecondaryTextBrush}" Grid.Column="1"/>
                            </Grid>
                            <Border Height="1" Background="{ThemeResource OmenCardBorderBaseBrush}"/>
                            <!-- Graphics Card -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Graphics Card Model" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource OmenPrimaryTextBrush}"/>
                                </StackPanel>
                                <TextBlock x:Name="GpuNameText" Text="Unknown GPU" FontSize="12" Foreground="{ThemeResource OmenSecondaryTextBrush}" VerticalAlignment="Center" Grid.Column="1"/>
                            </Grid>
                            <Border Height="1" Background="{ThemeResource OmenCardBorderBaseBrush}"/>
                            <!-- Driver Version -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Driver Version" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource OmenPrimaryTextBrush}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="GpuDriverText" Text="Unknown" FontSize="12" Foreground="{ThemeResource OmenSecondaryTextBrush}" VerticalAlignment="Center" Grid.Column="1"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- GPU Apps Links -->
                    <Border Style="{StaticResource LltCardStyle}" Margin="0,8,0,0">
                        <Grid Style="{StaticResource LltRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE7EE;" FontSize="20" Margin="0,0,16,0" Foreground="{ThemeResource OmenSecondaryTextBrush}"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Graphics Control Panel" FontWeight="SemiBold" FontSize="14" Foreground="{ThemeResource OmenPrimaryTextBrush}"/>
                                <TextBlock Text="Open NVIDIA Control Panel or AMD Software" FontSize="11" Foreground="{ThemeResource OmenSecondaryTextBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                <Button x:Name="BtnOpenNvidia" Content="NVIDIA" Click="BtnOpenNvidia_Click" Visibility="Collapsed"/>
                                <Button x:Name="BtnOpenAmd" Content="AMD" Click="BtnOpenAmd_Click" Visibility="Collapsed"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>
