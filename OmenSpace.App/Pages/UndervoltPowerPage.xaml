<Page
    x:Class="OmenSpace_App.Pages.UndervoltPowerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Padding="24,20,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="Undervolt &amp; Power" FontSize="28" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Margin="0,0,0,4"/>
            <TextBlock Text="Advanced CPU tuning and power limits for Intel and AMD processors." FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="24">
                
                <!-- CPU Warning / Info -->
                <InfoBar x:Name="CpuSupportInfoBar" IsOpen="True" Severity="Warning" Title="Checking CPU Support..." Message="Loading hardware specifications." IsClosable="False" />

                <!-- Voltage Offsets -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Voltage Offsets" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        
                        <!-- Core Offset -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Core Voltage Offset" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="Negative values reduce temperatures without losing performance." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <Slider x:Name="CoreOffsetSlider" Grid.Column="1" Minimum="-150" Maximum="0" StepFrequency="5" Value="0" VerticalAlignment="Center" Margin="16,0" ValueChanged="CoreOffsetSlider_ValueChanged"/>
                            <TextBlock x:Name="CoreOffsetLabel" Grid.Column="2" Text="0 mV" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                        </Grid>

                        <MenuFlyoutSeparator Margin="0,8"/>

                        <!-- Cache Offset -->
                        <Grid x:Name="CacheOffsetContainer">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Cache Voltage Offset" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="Usually kept identical to Core Offset on Intel CPUs." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <Slider x:Name="CacheOffsetSlider" Grid.Column="1" Minimum="-150" Maximum="0" StepFrequency="5" Value="0" VerticalAlignment="Center" Margin="16,0" ValueChanged="CacheOffsetSlider_ValueChanged"/>
                            <TextBlock x:Name="CacheOffsetLabel" Grid.Column="2" Text="0 mV" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Power Limits -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Power Limits &amp; Thermals" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        
                        <!-- PL1 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Sustained Power Limit (PL1)" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="Maximum power drawn during long, continuous workloads." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <Slider x:Name="Pl1Slider" Grid.Column="1" Minimum="25" Maximum="75" StepFrequency="1" Value="45" VerticalAlignment="Center" Margin="16,0" ValueChanged="Pl1Slider_ValueChanged"/>
                            <TextBlock x:Name="Pl1Label" Grid.Column="2" Text="45 W" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                        </Grid>

                        <MenuFlyoutSeparator Margin="0,8"/>

                        <!-- PL2 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Turbo Power Limit (PL2)" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="Maximum power drawn during short turbo bursts." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <Slider x:Name="Pl2Slider" Grid.Column="1" Minimum="45" Maximum="115" StepFrequency="1" Value="95" VerticalAlignment="Center" Margin="16,0" ValueChanged="Pl2Slider_ValueChanged"/>
                            <TextBlock x:Name="Pl2Label" Grid.Column="2" Text="95 W" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                        </Grid>
                        
                        <MenuFlyoutSeparator Margin="0,8"/>

                        <!-- TCC Offset -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Thermal Throttling Offset (TCC)" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="Reduces max CPU temperature limit (e.g. 15 = max 85°C)." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <Slider x:Name="TccSlider" Grid.Column="1" Minimum="0" Maximum="15" StepFrequency="1" Value="3" VerticalAlignment="Center" Margin="16,0" ValueChanged="TccSlider_ValueChanged"/>
                            <TextBlock x:Name="TccLabel" Grid.Column="2" Text="97°C (-3°C)" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                        </Grid>

                    </StackPanel>
                </Border>
                
                <!-- Action Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" Margin="0,16,0,40">
                    <Button x:Name="BtnReset" Content="Reset Defaults" Click="BtnReset_Click"/>
                    <Button x:Name="BtnApply" Content="Apply Settings" Style="{StaticResource AccentButtonStyle}" Click="BtnApply_Click"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
