<Page
    x:Class="OmenSpace_App.Pages.LightingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:OmenSpace_App.Controls"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Background="{ThemeResource OmenAppBackgroundBrush}" Padding="24,20,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="LIGHTING STUDIO" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource OmenPrimaryTextBrush}"/>
                <TextBlock Text="Configure your device's background lighting and dynamic effects." FontSize="12" Foreground="{ThemeResource OmenTertiaryTextBrush}" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Scrollable Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="24">
                
                <!-- Keyboard Display Area Card -->
                <Border Background="{ThemeResource OmenCardBackgroundDarkBrush}" BorderBrush="{ThemeResource OmenCardBorderDarkBrush}" BorderThickness="1" CornerRadius="10" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Keyboard Display Area with Viewbox -->
                        <Viewbox Grid.Row="0" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,24" MaxWidth="800" MaxHeight="250">
                            <Grid>
                                <!-- Glow effect -->
                                <Grid x:Name="BackgroundGlowGrid" Margin="-20">
                                    <!-- Single Zone -->
                                    <Border x:Name="SingleZoneGlow" Visibility="Collapsed" CornerRadius="30">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                <GradientStop x:Name="SzStop1" Color="#2010B981" Offset="0.0"/>
                                                <GradientStop x:Name="SzStop2" Color="#7010B981" Offset="0.5"/>
                                                <GradientStop x:Name="SzStop3" Color="#0010B981" Offset="1.0"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>

                                    <!-- Multi Zone -->
                                    <Grid x:Name="MultiZoneGlow" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <Border Grid.Column="0" CornerRadius="30,0,0,30">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                    <GradientStop x:Name="Mz0Stop1" Color="#20EF4444" Offset="0.0"/>
                                                    <GradientStop x:Name="Mz0Stop2" Color="#70EF4444" Offset="0.5"/>
                                                    <GradientStop x:Name="Mz0Stop3" Color="#00EF4444" Offset="1.0"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <Border Grid.Column="1">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                    <GradientStop x:Name="Mz1Stop1" Color="#20EAB308" Offset="0.0"/>
                                                    <GradientStop x:Name="Mz1Stop2" Color="#70EAB308" Offset="0.5"/>
                                                    <GradientStop x:Name="Mz1Stop3" Color="#00EAB308" Offset="1.0"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <Border Grid.Column="2">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                    <GradientStop x:Name="Mz2Stop1" Color="#2010B981" Offset="0.0"/>
                                                    <GradientStop x:Name="Mz2Stop2" Color="#7010B981" Offset="0.5"/>
                                                    <GradientStop x:Name="Mz2Stop3" Color="#0010B981" Offset="1.0"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <Border Grid.Column="3" CornerRadius="0,30,30,0">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                                    <GradientStop x:Name="Mz3Stop1" Color="#203B82F6" Offset="0.0"/>
                                                    <GradientStop x:Name="Mz3Stop2" Color="#703B82F6" Offset="0.5"/>
                                                    <GradientStop x:Name="Mz3Stop3" Color="#003B82F6" Offset="1.0"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                </Grid>

                                <!-- Actual Keyboard Visualizer -->
                                <controls:KeyboardVisualizer x:Name="Visualizer" />
                            </Grid>
                        </Viewbox>
                        
                        <TextBlock Grid.Row="1" x:Name="SelectedZoneText" Text="Selected Zone: 1 (Left)" FontWeight="SemiBold" Foreground="{ThemeResource OmenPrimaryTextBrush}" HorizontalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Config & Color Controls Grid -->
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Column Controls: Effect, Brightness, Speed -->
                    <Border Grid.Column="0" Background="{ThemeResource OmenCardBackgroundDarkBrush}" BorderBrush="{ThemeResource OmenCardBorderDarkBrush}" BorderThickness="1" CornerRadius="10" Padding="18">
                        <StackPanel Spacing="16">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE765;" FontSize="15" Foreground="#8B5CF6"/>
                                <TextBlock Text="Effect &amp; Speed Settings" FontSize="14" FontWeight="Bold" Foreground="{ThemeResource OmenPrimaryTextBrush}"/>
                            </StackPanel>

                            <!-- Dynamic Lighting Toggle -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Windows Dynamic Lighting" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource OmenPrimaryTextBrush}"/>
                                    <TextBlock Text="Yield lighting control to Windows" FontSize="11" Foreground="{ThemeResource OmenTertiaryTextBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                                <ToggleSwitch x:Name="DynamicLightingToggle" Grid.Column="1" Toggled="DynamicLightingToggle_Toggled" OnContent="" OffContent="" Margin="0,0,-8,0" />
                            </Grid>
                            
                            <!-- Effect ComboBox -->
                            <StackPanel Spacing="6" x:Name="EffectSettingsPanel">
                                <TextBlock Text="Lighting Effect" FontSize="11" Foreground="{ThemeResource OmenTertiaryTextBrush}"/>
                                <ComboBox x:Name="EffectComboBox" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="EffectComboBox_SelectionChanged" Background="{ThemeResource OmenCardBackgroundElevatedBrush}" BorderBrush="{ThemeResource OmenCardBorderElevatedBrush}" Foreground="{ThemeResource OmenPrimaryTextBrush}">
                                    <ComboBoxItem Content="Static"/>
                                    <ComboBoxItem Content="Breathing"/>
                                    <ComboBoxItem Content="Color Cycle"/>
                                    <ComboBoxItem Content="Wave"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- Brightness Slider -->
                            <StackPanel Spacing="6">
                                <Grid>
                                    <TextBlock Text="Brightness" FontSize="11" Foreground="{ThemeResource OmenTertiaryTextBrush}"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding ElementName=BrightnessSlider, Path=Value}" FontSize="11" Foreground="#8B5CF6"/>
                                        <TextBlock Text="%" FontSize="11" Foreground="#8B5CF6"/>
                                    </StackPanel>
                                </Grid>
                                <Slider x:Name="BrightnessSlider" Minimum="0" Maximum="100" Value="100" StepFrequency="10" ValueChanged="BrightnessSlider_ValueChanged"/>
                            </StackPanel>

                            <!-- Speed Slider -->
                            <StackPanel Spacing="6">
                                <Grid>
                                    <TextBlock Text="Effect Speed" FontSize="11" Foreground="{ThemeResource OmenTertiaryTextBrush}"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding ElementName=SpeedSlider, Path=Value}" FontSize="11" Foreground="#8B5CF6"/>
                                        <TextBlock Text="%" FontSize="11" Foreground="#8B5CF6"/>
                                    </StackPanel>
                                </Grid>
                                <Slider x:Name="SpeedSlider" Minimum="1" Maximum="100" Value="50" StepFrequency="5" ValueChanged="SpeedSlider_ValueChanged"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Right Column Controls: Color Selection -->
                    <Border Grid.Column="1" Background="{ThemeResource OmenCardBackgroundDarkBrush}" BorderBrush="{ThemeResource OmenCardBorderDarkBrush}" BorderThickness="1" CornerRadius="10" Padding="18">
                        <StackPanel Spacing="16" VerticalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE790;" FontSize="15" Foreground="#FF00A2"/>
                                <TextBlock Text="Color Selection" FontSize="14" FontWeight="Bold" Foreground="{ThemeResource OmenPrimaryTextBrush}"/>
                            </StackPanel>

                            <TextBlock Text="Assign a preset or custom color to a specific zone or the entire keyboard." FontSize="11" Foreground="{ThemeResource OmenTertiaryTextBrush}" Margin="0,0,0,8"/>

                            <!-- Presets Grid -->
                            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,4,0,16">
                                <Button Width="36" Height="36" CornerRadius="18" BorderThickness="1.5" BorderBrush="{ThemeResource OmenCardBorderElevatedBrush}" Background="#FF0000" Click="PresetColor_Click"/>
                                <Button Width="36" Height="36" CornerRadius="18" BorderThickness="1.5" BorderBrush="{ThemeResource OmenCardBorderElevatedBrush}" Background="#FFFF00" Click="PresetColor_Click"/>
                                <Button Width="36" Height="36" CornerRadius="18" BorderThickness="1.5" BorderBrush="{ThemeResource OmenCardBorderElevatedBrush}" Background="#00FF00" Click="PresetColor_Click"/>
                                <Button Width="36" Height="36" CornerRadius="18" BorderThickness="1.5" BorderBrush="{ThemeResource OmenCardBorderElevatedBrush}" Background="#0000FF" Click="PresetColor_Click"/>
                                <Button Width="36" Height="36" CornerRadius="18" BorderThickness="1.5" BorderBrush="{ThemeResource OmenCardBorderElevatedBrush}" Background="#FF00FF" Click="PresetColor_Click"/>
                                <Button Width="36" Height="36" CornerRadius="18" BorderThickness="1.5" BorderBrush="{ThemeResource OmenCardBorderElevatedBrush}" Background="#FFFFFF" Click="PresetColor_Click"/>
                                
                                <!-- Custom Color Picker Button -->
                                <Button Width="36" Height="36" CornerRadius="18" BorderThickness="1.5" BorderBrush="{ThemeResource OmenCardBorderElevatedBrush}" Padding="0" ToolTipService.ToolTip="Custom Color">
                                    <Button.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#FF0000" Offset="0.0"/>
                                            <GradientStop Color="#FFFF00" Offset="0.33"/>
                                            <GradientStop Color="#00FF00" Offset="0.66"/>
                                            <GradientStop Color="#0000FF" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Button.Background>
                                    <Button.Flyout>
                                        <Flyout>
                                            <StackPanel Spacing="12" Background="{ThemeResource OmenCardBackgroundElevatedBrush}" Padding="12" CornerRadius="8">
                                                <TextBlock Text="Select Custom Color" FontWeight="Bold" Foreground="{ThemeResource OmenPrimaryTextBrush}"/>
                                                <ColorPicker x:Name="ZoneColorPicker" IsMoreButtonVisible="True" IsColorSliderVisible="True" IsColorChannelTextInputVisible="True" IsHexInputVisible="True" IsAlphaEnabled="False" ColorChanged="ZoneColorPicker_ColorChanged" Height="300" Foreground="{ThemeResource OmenPrimaryTextBrush}"/>
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>
                            
                            <Border BorderBrush="{ThemeResource OmenCardBorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Background="{ThemeResource OmenCardBackgroundBaseBrush}">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Path Data="M 12,2 L 22,12 L 12,22 L 2,12 Z" Fill="#FF00A2" Height="14" Width="14" Stretch="Uniform" VerticalAlignment="Center"/>
                                    <TextBlock Text="OMEN RGB controller detected." FontSize="11" Foreground="{ThemeResource OmenTertiaryTextBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
                
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>


