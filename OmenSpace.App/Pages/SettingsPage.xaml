<Page
    x:Class="OmenSpace_App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:OmenSpace_App.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Background="{ThemeResource OmenAppBackgroundBrush}" Padding="24,20,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="General Settings" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource OmenPrimaryTextBrush}"/>
                <TextBlock Text="Configure application startup, appearance, and emergency thermal limits." FontSize="12" Foreground="{ThemeResource OmenTertiaryTextBrush}" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>
        
        <!-- Scrollable settings list -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="20" MaxWidth="900" HorizontalAlignment="Left">
                
                <!-- Card 1: Balang & Grnm Settings -->
                <Border Background="{ThemeResource OmenCardBackgroundDarkBrush}" BorderBrush="{ThemeResource OmenCardBorderDarkBrush}" BorderThickness="1" CornerRadius="10" Padding="20">
                    <StackPanel Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE7F4;" FontSize="15" Foreground="#3B82F6"/>
                            <TextBlock Text="System &amp; Appearance" FontSize="14" FontWeight="Bold" Foreground="{ThemeResource OmenPrimaryTextBrush}"/>
                        </StackPanel>

                        <!-- Balangta altrma -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Run at Startup" FontWeight="SemiBold" Foreground="{ThemeResource OmenPrimaryTextBrush}"/>
                                <TextBlock Text="Choose how the application should start when you log in." Foreground="{ThemeResource OmenTertiaryTextBrush}" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ComboBox x:Name="ComboStartupMode" Grid.Column="1" Width="160" VerticalAlignment="Center" SelectionChanged="ComboStartupMode_SelectionChanged" Background="{ThemeResource OmenCardBackgroundElevatedBrush}" BorderBrush="{ThemeResource OmenCardBorderElevatedBrush}" Foreground="{ThemeResource OmenPrimaryTextBrush}">
                                <ComboBoxItem Content="Open Application" Tag="OpenUI"/>
                                <ComboBoxItem Content="Start in System Tray" Tag="Tray"/>
                                <ComboBoxItem Content="Disabled" Tag="Disabled"/>
                            </ComboBox>
                        </Grid>

                        <Border Height="1" Background="{ThemeResource OmenCardBorderDarkBrush}" Margin="0,4,0,4"/>

                        <!-- Uygulama Temas -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="App Theme" FontWeight="SemiBold" Foreground="{ThemeResource OmenPrimaryTextBrush}"/>
                                <TextBlock Text="Change the color theme of the application (Dark recommended)." Foreground="{ThemeResource OmenTertiaryTextBrush}" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ComboBox x:Name="ComboTheme" Grid.Column="1" Width="160" VerticalAlignment="Center" SelectionChanged="ComboTheme_SelectionChanged" Background="{ThemeResource OmenCardBackgroundElevatedBrush}" BorderBrush="{ThemeResource OmenCardBorderElevatedBrush}" Foreground="{ThemeResource OmenPrimaryTextBrush}">
                                <ComboBoxItem Content="System Default" Tag="System"/>
                                <ComboBoxItem Content="Light Theme" Tag="Light"/>
                                <ComboBoxItem Content="Dark Theme" Tag="Dark"/>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>
                
                <!-- Card 2: Gvenlik ve Koruma Settings -->
                <Border Background="{ThemeResource OmenCardBackgroundDarkBrush}" BorderBrush="{ThemeResource OmenCardBorderDarkBrush}" BorderThickness="1" CornerRadius="10" Padding="20">
                    <StackPanel Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE7BA;" FontSize="15" Foreground="#FF3B30"/>
                            <TextBlock Text="Safety &amp; Thermal Protection" FontSize="14" FontWeight="Bold" Foreground="{ThemeResource OmenPrimaryTextBrush}"/>
                        </StackPanel>
                        
                        <!-- Acil Durum Max Fan -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Emergency Max Fan Safety" FontWeight="SemiBold" Foreground="{ThemeResource OmenPrimaryTextBrush}"/>
                                <TextBlock Text="Automatically sets fans to maximum speed when temperature reaches 95Â°C to protect the system." Foreground="{ThemeResource OmenTertiaryTextBrush}" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="ToggleThermalSafety" Grid.Column="1" VerticalAlignment="Center" Toggled="ToggleThermalSafety_Toggled"/>
                        </Grid>

                        <Border Height="1" Background="{ThemeResource OmenCardBorderDarkBrush}" Margin="0,4,0,4"/>

                        <!-- Quiet Safety -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Quiet Mode Safety" FontWeight="SemiBold" Foreground="{ThemeResource OmenPrimaryTextBrush}"/>
                                <TextBlock Text="Automatically switches profile to Default mode if CPU temperature exceeds 93Â°C for 8 seconds while in Quiet mode." Foreground="{ThemeResource OmenTertiaryTextBrush}" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="ToggleQuietSafety" Grid.Column="1" VerticalAlignment="Center" Toggled="ToggleQuietSafety_Toggled"/>
                        </Grid>

                        <Border BorderBrush="{ThemeResource OmenCardBorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Background="{ThemeResource OmenCardBackgroundPressedBrush}" Margin="0,4,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE7BA;" FontSize="14" Foreground="#D97706"/>
                                <TextBlock Text="âš ï¸ CAUTION: Disabling safety limits may cause thermal throttling or overheating." FontSize="11" Foreground="#F43F5E" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Card 3: Tanlama Raporu -->
                <Border Background="{ThemeResource OmenCardBackgroundDarkBrush}" BorderBrush="{ThemeResource OmenCardBorderDarkBrush}" BorderThickness="1" CornerRadius="10" Padding="20">
                    <StackPanel Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE9D9;" FontSize="15" Foreground="#10B981"/>
                            <TextBlock Text="Diagnostics &amp; Reporting" FontSize="14" FontWeight="Bold" Foreground="{ThemeResource OmenPrimaryTextBrush}"/>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Export Diagnostics (ZIP)" FontWeight="SemiBold" Foreground="{ThemeResource OmenPrimaryTextBrush}"/>
                                <TextBlock Text="Saves fan history, EC state data, and hardware information as a ZIP file to your Desktop." Foreground="{ThemeResource OmenTertiaryTextBrush}" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button x:Name="BtnExportDiagnostics" Content="Generate Report" Grid.Column="1" VerticalAlignment="Center" Click="BtnExportDiagnostics_Click" Style="{StaticResource AccentButtonStyle}" Background="#2563EB" BorderBrush="#3B82F6" Foreground="#FFFFFF"/>
                        </Grid>
                    </StackPanel>
                </Border>
                
                <!-- Card 4: Hakknda -->
                <Border Background="{ThemeResource OmenCardBackgroundDarkBrush}" BorderBrush="{ThemeResource OmenCardBorderDarkBrush}" BorderThickness="1" CornerRadius="10" Padding="20">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Path Data="M 12,2 L 22,12 L 12,22 L 2,12 Z" Fill="#E00078" Height="14" Width="14" Stretch="Uniform" VerticalAlignment="Center"/>
                            <TextBlock Text="About" FontSize="14" FontWeight="Bold" Foreground="{ThemeResource OmenPrimaryTextBrush}"/>
                        </StackPanel>
                        
                        <TextBlock Text="OmenSpace is an open-source, independent application developed to manage HP devices." Foreground="{ThemeResource OmenSecondaryTextBrush}" FontSize="12" TextWrapping="Wrap"/>
                        <TextBlock Text="âš ï¸ Not affiliated with or endorsed by HP Inc." Foreground="#D97706" FontWeight="SemiBold" FontSize="11" TextWrapping="Wrap"/>
                        
                        <HyperlinkButton Content="GitHub Repository and Source Code" NavigateUri="https://github.com/yeyil" Padding="0" Margin="0,4,0,0" Foreground="#3B82F6"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>


