<Page
    x:Class="OmenSpace_App.Pages.PerformancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource OmenAppBackgroundBrush}">

    <Page.Resources>
        <!-- Metric Progress Bar Style -->
        <Style TargetType="ProgressBar" x:Key="MetricProgressBarStyle">
            <Setter Property="Height" Value="6" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Background" Value="{ThemeResource OmenCardBorderElevatedBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource OmenAccentBrush}" />
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        
        <!-- LLT Style Card Container -->
        <Style TargetType="Border" x:Key="LltCardStyle">
            <Setter Property="Background" Value="{ThemeResource OmenCardBackgroundDarkBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource OmenCardBorderDarkBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>

        <!-- LLT Style Row Container -->
        <Style TargetType="Grid" x:Key="LltRowStyle">
            <Setter Property="Padding" Value="16" />
            <Setter Property="MinHeight" Value="64" />
        </Style>

        <!-- LLT Metric Text Style -->
        <Style TargetType="TextBlock" x:Key="LltMetricValueStyle">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource OmenPrimaryTextBrush}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Width" Value="70" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
        
        <Style TargetType="TextBlock" x:Key="LltMetricLabelStyle">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource OmenSecondaryTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Width" Value="90" />
        </Style>
    </Page.Resources>

    <!-- HIDDEN ELEMENTS FOR BACKWARD COMPATIBILITY WITH C# CODE BEHIND -->
    <Grid>
        <StackPanel Visibility="Collapsed">
            <RadioButton x:Name="BtnPerfQuiet" />
            <RadioButton x:Name="BtnPerfDefault" />
            <RadioButton x:Name="BtnPerfPerf" />
            <RadioButton x:Name="BtnFanAuto" />
            <RadioButton x:Name="BtnFanOmenSpace" />
            <RadioButton x:Name="BtnFanMax" />
            <RadioButton x:Name="BtnFanManual" />
            <TextBlock x:Name="CpuPowerTextDetailed" />
            <TextBlock x:Name="GpuPowerTextDetailed" />
            <TextBlock x:Name="TotalPowerTextDetailed" />
            <TextBlock x:Name="FanModeDescText" />
        </StackPanel>

        <Grid Padding="24">
            <!-- Loading State -->
            <Grid x:Name="MetricsLoadingContainer" Visibility="Visible">
                <ProgressRing IsActive="True" Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource OmenAccentBrush}"/>
            </Grid>

            <Grid x:Name="MetricsContainer" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Top Metrics -->
                    <RowDefinition Height="24"/>   <!-- Spacer -->
                    <RowDefinition Height="Auto"/> <!-- Cards Header -->
                    <RowDefinition Height="*"/>    <!-- Cards -->
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /> <!-- CPU / Power Column -->
                    <ColumnDefinition Width="32" /> <!-- Spacer -->
                    <ColumnDefinition Width="*" /> <!-- GPU / Fan Column -->
                </Grid.ColumnDefinitions>

                <!-- TOP METRICS SECTION -->
                <!-- CPU Metrics -->
                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Text="CPU" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"/>
                    
                    <!-- Utilization -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Utilization" Style="{StaticResource LltMetricLabelStyle}" />
                        <ProgressBar Grid.Column="1" Value="0" Maximum="100" Style="{StaticResource MetricProgressBarStyle}" x:Name="CpuUsageBar"/>
                        <TextBlock Grid.Column="2" x:Name="CpuUsageText" Text="%0" Style="{StaticResource LltMetricValueStyle}"/>
                    </Grid>

                    <!-- Core Clock (Power mapped to here for now) -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Power" Style="{StaticResource LltMetricLabelStyle}" />
                        <ProgressBar Grid.Column="1" Value="0" Maximum="100" Foreground="#F59E0B" Style="{StaticResource MetricProgressBarStyle}"/>
                        <TextBlock Grid.Column="2" x:Name="CpuPowerText" Text="-- W" Style="{StaticResource LltMetricValueStyle}"/>
                    </Grid>

                    <!-- Temperature -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Temperature" Style="{StaticResource LltMetricLabelStyle}" />
                        <ProgressBar Grid.Column="1" Value="0" Maximum="100" Foreground="#EF4444" Style="{StaticResource MetricProgressBarStyle}"/>
                        <TextBlock Grid.Column="2" x:Name="CpuTempText" Text="-- °C" Style="{StaticResource LltMetricValueStyle}"/>
                    </Grid>

                    <!-- Fan -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Fan" Style="{StaticResource LltMetricLabelStyle}" />
                        <ProgressBar Grid.Column="1" Value="0" Maximum="5000" Foreground="#10B981" Style="{StaticResource MetricProgressBarStyle}"/>
                        <TextBlock Grid.Column="2" x:Name="CpuFanText" Text="-- RPM" Style="{StaticResource LltMetricValueStyle}"/>
                    </Grid>
                </StackPanel>

                <!-- GPU Metrics -->
                <StackPanel Grid.Row="0" Grid.Column="2">
                    <TextBlock Text="GPU" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16"/>
                    
                    <!-- Utilization -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Utilization" Style="{StaticResource LltMetricLabelStyle}" />
                        <ProgressBar Grid.Column="1" Value="0" Maximum="100" Style="{StaticResource MetricProgressBarStyle}" x:Name="GpuUsageBar"/>
                        <TextBlock Grid.Column="2" x:Name="GpuUsageText" Text="%0" Style="{StaticResource LltMetricValueStyle}"/>
                    </Grid>

                    <!-- Core Clock (Power mapped to here for now) -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Power" Style="{StaticResource LltMetricLabelStyle}" />
                        <ProgressBar Grid.Column="1" Value="0" Maximum="150" Foreground="#F59E0B" Style="{StaticResource MetricProgressBarStyle}"/>
                        <TextBlock Grid.Column="2" x:Name="GpuPowerText" Text="-- W" Style="{StaticResource LltMetricValueStyle}"/>
                    </Grid>

                    <!-- Temperature -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Temperature" Style="{StaticResource LltMetricLabelStyle}" />
                        <ProgressBar Grid.Column="1" Value="0" Maximum="100" Foreground="#EF4444" Style="{StaticResource MetricProgressBarStyle}"/>
                        <TextBlock Grid.Column="2" x:Name="GpuTempText" Text="-- °C" Style="{StaticResource LltMetricValueStyle}"/>
                    </Grid>

                    <!-- Fan -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Fan" Style="{StaticResource LltMetricLabelStyle}" />
                        <ProgressBar Grid.Column="1" Value="0" Maximum="5000" Foreground="#10B981" Style="{StaticResource MetricProgressBarStyle}"/>
                        <TextBlock Grid.Column="2" x:Name="GpuFanText" Text="-- RPM" Style="{StaticResource LltMetricValueStyle}"/>
                    </Grid>
                </StackPanel>

                <!-- TITLES -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Power" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" Foreground="{ThemeResource OmenPrimaryTextBrush}"/>
                <TextBlock Grid.Row="2" Grid.Column="2" Text="Cooling" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" Foreground="{ThemeResource OmenPrimaryTextBrush}"/>

                <!-- CARDS SECTION -->
                <StackPanel Grid.Row="3" Grid.Column="0">
                    <!-- Power Card -->
                    <Border Style="{StaticResource LltCardStyle}">
                        <StackPanel>
                            <!-- Power Mode Row -->
                            <Grid Style="{StaticResource LltRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE9D9;" FontSize="20" Margin="0,0,16,0" Foreground="{ThemeResource OmenSecondaryTextBrush}"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Power Mode" FontWeight="SemiBold" FontSize="14" Foreground="{ThemeResource OmenPrimaryTextBrush}"/>
                                    <TextBlock Text="Change performance mode. Requires Omen Command Center service." FontSize="11" Foreground="{ThemeResource OmenSecondaryTextBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ComboBox x:Name="CmbPowerMode" Grid.Column="2" Width="130" VerticalAlignment="Center" SelectedIndex="1" SelectionChanged="CmbPowerMode_SelectionChanged">
                                    <ComboBoxItem Content="Eco (Sessiz)" />
                                    <ComboBoxItem Content="Balanced" />
                                    <ComboBoxItem Content="Performance" />
                                </ComboBox>
                            </Grid>

                            <Border Height="1" Background="{ThemeResource OmenCardBorderDarkBrush}" Margin="16,0" />

                            <!-- CPU Turbo Boost Row -->
                            <Grid Style="{StaticResource LltRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE9D2;" FontSize="20" Margin="0,0,16,0" Foreground="{ThemeResource OmenSecondaryTextBrush}"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="CPU Turbo Boost" FontWeight="SemiBold" FontSize="14" Foreground="{ThemeResource OmenPrimaryTextBrush}"/>
                                    <TextBlock Text="Enable or disable CPU Turbo Boost to control temperatures." FontSize="11" Foreground="{ThemeResource OmenSecondaryTextBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch x:Name="ToggleCpuTurbo" Grid.Column="2" VerticalAlignment="Center" Toggled="ToggleCpuTurbo_Toggled" OnContent="" OffContent="" Margin="0,0,-8,0" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="3" Grid.Column="2">
                    <!-- Fan Card -->
                    <Border Style="{StaticResource LltCardStyle}">
                        <StackPanel>
                            <!-- Fan Mode Row -->
                            <Grid Style="{StaticResource LltRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE7A3;" FontSize="20" Margin="0,0,16,0" Foreground="{ThemeResource OmenSecondaryTextBrush}"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Fan Mode" FontWeight="SemiBold" FontSize="14" Foreground="{ThemeResource OmenPrimaryTextBrush}"/>
                                    <TextBlock Text="Select how cooling fans should operate." FontSize="11" Foreground="{ThemeResource OmenSecondaryTextBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ComboBox x:Name="CmbFanMode" Grid.Column="2" Width="130" VerticalAlignment="Center" SelectedIndex="0" SelectionChanged="CmbFanMode_SelectionChanged">
                                    <ComboBoxItem Content="Auto" />
                                    <ComboBoxItem Content="Flow" />
                                    <ComboBoxItem Content="Max" />
                                    <ComboBoxItem Content="Manual" />
                                </ComboBox>
                            </Grid>
                            
                            <Border Height="1" Background="{ThemeResource OmenCardBorderDarkBrush}" Margin="16,0" />

                            <!-- Dust Cleaning Row -->
                            <Grid Style="{StaticResource LltRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE81D;" FontSize="20" Margin="0,0,16,0" Foreground="{ThemeResource OmenSecondaryTextBrush}"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Dust Cleaning" FontWeight="SemiBold" FontSize="14" Foreground="{ThemeResource OmenPrimaryTextBrush}"/>
                                    <TextBlock Text="Runs fans at maximum speed to clear dust." FontSize="11" Foreground="{ThemeResource OmenSecondaryTextBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button x:Name="BtnDustCleaning" Grid.Column="2" Content="Start" Width="130" VerticalAlignment="Center" Click="BtnDustCleaning_Click" />
                            </Grid>
                            
                            <Border Height="1" Background="{ThemeResource OmenCardBorderDarkBrush}" Margin="16,0" />
                            
                            <!-- Fan Logs Row -->
                            <Grid Style="{StaticResource LltRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE9F9;" FontSize="20" Margin="0,0,16,0" Foreground="{ThemeResource OmenSecondaryTextBrush}"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Diagnostics" FontWeight="SemiBold" FontSize="14" Foreground="{ThemeResource OmenPrimaryTextBrush}"/>
                                    <TextBlock Text="View detailed fan operation logs." FontSize="11" Foreground="{ThemeResource OmenSecondaryTextBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button x:Name="BtnShowFanLogs" Grid.Column="2" Content="View Logs" Width="130" VerticalAlignment="Center" Click="BtnShowFanLogs_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </Grid>
        </Grid>
    </Grid>
</Page>
